  - key: skill_2_name
    ja: "\u30D5\u30A9\u30FC\u30B9\u30B5\u30F3\u30C0\u30FC\u30E1\u30C0\u30EB"
    en: Force Thunder Medal
  - key: Skill_2_des
    ja: "\u30E1\u30C0\u30EB\u767A\u5C04\u6642\u30011\uFF05\u306E\u78BA\u7387\u3067\u30D5\u30A9\u30FC\u30B9\u30B5\u30F3\u30C0\u30FC\u30E1\u30C0\u30EB\u304C\u767A\u5C04\u3055\u308C\u308B\u3002\\n\u3053\u306E\u30E1\u30C0\u30EB\u3092\u7372\u5F97\u3059\u308B\u3068\u30D5\u30A9\u30FC\u30B9\u30B5\u30F3\u30C0\u30FC\u304C\u767A\u52D5\u3059\u308B\u3002\\n\u5A01\u529B1000\uFF05\xD7\u30AF\u30EA\u30C6\u30A3\u30AB\u30EB\u30C0\u30E1\u30FC\u30B8\u500D\u7387"
    en: "When firing a medal there is a 1% chance to fire a Force Thunder Medal.
      Collecting this medal activates Force Thunder. Power: 1000% \xD7 Critical Damage
      Multiplier."
  - key: skill_3_name
